[Unit]
Description=Dynamic Island Shell UI
Requires=isled.service
After=isled.service

[Service]
Type=simple
ExecStart=/run/current-system/sw/bin/quickshell -p %h/Projects/dynamic-island/ui
Restart=on-failure
RestartSec=2

Environment=QT_QPA_PLATFORM=wayland
Environment=NIXOS_OZONE_WL=1

ImportEnvironment=WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_TYPE NIRI_SOCKET HYPRLAND_INSTANCE_SIGNATURE DBUS_SESSION_BUS_ADDRESS

[Install]
WantedBy=graphical-session.target
