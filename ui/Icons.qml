    /// The path for an icon, or a sensible fallback.
    function path(name) {
        var value = paths[name];
        if (value === undefined)
            return paths["spark"];
        return value;
    }

    /// The filled variant, when there is one, and the outline when
    /// there is not. Icons that have no filled form are drawn as they
    /// always were.
    function fillPath(name) {
        var value = fillPaths[name];
        if (value === undefined)
            return path(name);
        return value;
    }

    /// Whether an icon has a filled form at all.
    function hasFill(name) {
        return fillPaths[name] !== undefined;
    }
