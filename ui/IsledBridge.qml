import QtQuick
import Quickshell
import Quickshell.Io

// The connection to the isled daemon.
//
// The daemon owns the truth: the todos, the timer, the notes, the clipboard,
// the wallpaper catalog and the live-activity queue all live there. This
// bridge connects to the socket, applies the events that arrive, and sends
// commands back.
//
// It also reconnects. A daemon restart should leave the island alive, not
// leave it showing "offline" until the next login.
QtObject {
    id: bridge

    // ---- where the daemon is ----

    readonly property string explicitSocket: Quickshell.env("ISLED_SOCKET")
    readonly property string runtimeDir: Quickshell.env("XDG_RUNTIME_DIR")
    readonly property string socketPath: explicitSocket
        ? explicitSocket
        : (runtimeDir ? runtimeDir + "/isled/isled.sock" : "/tmp/isled/isled.sock")

    property bool connected: false
    /// Whether to reach for the daemon on startup. The preview rig turns it
    /// off when it is only photographing the island.
    property bool autoConnect: true
    property string lastError: ""
    property string lastTopic: ""

    // ---- the state ----

    property var snapshot: null
    property var stats: null
    property var notifications: []
    property int unreadCount: 0

    /// The persistent condition the island is anchored to.
    property var activity: null
    /// Everything the island has seen recently, newest first.
    property var activities: []

    property var todos: []
    property var timer: null
    property var notes: []
    property var notesDir: ""
    property var clipboard: []
    property var wallpapers: null
    property var calendar: null
    property var settings: null
    /// The system tray's items.
    property var tray: []

    // ---- requests ----

    property int nextId: 1
    property var pending: ({})
    property int pendingBytes: 0

    // ---- signals ----

    signal viewRequested(int index)
    signal viewStepped(int delta)
    signal toggleRequested()
    signal focusRequested()
    signal activityTriggered(var activity)
    // `activityChanged` is generated by the `activity` property; it is not
    // declared here, or the two would collide.
    signal linkChanged(bool connected)

    // ---- the socket ----

    property Socket socket: Socket {
        id: sock
        path: bridge.socketPath
        connected: false

        onConnectionStateChanged: {
            if (sock.connected) {
                bridge.connected = true;
                bridge.linkChanged(true);
                bridge.onConnected();
            } else {
                bridge.connected = false;
                bridge.linkChanged(false);
                bridge.onDisconnected();
                bridge.retry();
            }
        }

        onError: (err) => {
            bridge.lastError = "socket error " + err;
        }

        parser: StdioCollector {
            id: collector
            waitForEnd: false
            onDataChanged: bridge.feed(collector.text)
        }
    }

    // ---- reading ----

    property string pendingText: ""
    property int consumed: 0

    /// The collector's text is cumulative, so only the part past `consumed` is
    /// new. Everything older has already been parsed.
    function feed(all) {
        if (all.length <= bridge.consumed)
            return;

        bridge.pendingText += all.slice(bridge.consumed);
        bridge.consumed = all.length;

        var lines = bridge.pendingText.split("\n");
        bridge.pendingText = lines.pop();
        for (var i = 0; i < lines.length; i++) {
            bridge.consume(lines[i]);
        }
    }

    function consume(line) {
        var trimmed = line.trim();
        if (trimmed === "")
            return;

        var message;
        try {
            message = JSON.parse(trimmed);
        } catch (err) {
            bridge.lastError = "could not parse " + trimmed;
            return;
        }

        if (message.t === "state") {
            applySnapshot(message.data);
        } else if (message.t === "reply") {
            handleReply(message);
        } else if (message.t === "event") {
            handleEvent(message.topic, message.data);
        }
    }

    function handleReply(message) {
        var callback = bridge.pending[message.id];
        if (callback) {
            delete bridge.pending[message.id];
            callback(message.ok, message.data !== undefined ? message.data : null, message.error);
        }
    }

    function applySnapshot(data) {
        bridge.snapshot = data;
        if (data.notifications !== undefined)
            bridge.notifications = data.notifications;
        if (data.activity !== undefined)
            bridge.activity = data.activity;
        if (data.activities !== undefined)
            bridge.activities = data.activities;
        if (data.features)
            bridge.settings = null;
    }

    function handleEvent(topic, data) {
        bridge.lastTopic = topic;

        switch (topic) {
        case "system.stats":
            bridge.stats = data;
            break;
        case "notifications.added":
            bridge.onNotificationAdded(data);
            break;
        case "notifications.removed":
            bridge.onNotificationRemoved(data.id);
            break;
        case "notifications.cleared":
            bridge.notifications = [];
            bridge.unreadCount = 0;
            break;
        case "notifications.action":
            bridge.onNotificationRemoved(data.id);
            break;
        case "view.set":
            bridge.viewRequested(data.index | 0);
            break;
        case "view.step":
            bridge.viewStepped(data.delta | 0);
            break;
        case "island.toggle":
            bridge.toggleRequested();
            break;
        case "island.focus":
            bridge.focusRequested();
            break;
        case "activity.changed":
            bridge.activity = data.ambient !== undefined ? data.ambient : null;
            bridge.activities = data.recent !== undefined ? data.recent : [];
            bridge.activityChanged();
            break;
        case "activity.triggered":
            bridge.activityTriggered(data);
            break;
        case "todos.changed":
            bridge.call("todos.list", {}, function (ok, payload) {
                if (ok && payload)
                    bridge.todos = payload.items || [];
            });
            break;
        case "timer.tick":
        case "timer.changed":
            bridge.timer = data;
            break;
        case "notes.changed":
            bridge.reloadNotes();
            break;
        case "clipboard.changed":
            bridge.reloadClipboard();
            break;
        case "wallpaper.changed":
            bridge.reloadWallpapers();
            break;
        case "session.lagged":
            bridge.lastError = "missed " + data.missed + " events";
            break;
        default:
            break;
        }
    }

    // ---- notifications ----

    function onNotificationAdded(notification) {
        var items = bridge.notifications.slice();
        var replaced = false;
        for (var i = 0; i < items.length; i++) {
            if (items[i].id === notification.id) {
                items[i] = notification;
                replaced = true;
                break;
            }
        }
        if (!replaced) {
            items.unshift(notification);
        }
        bridge.notifications = items;
        bridge.unreadCount = bridge.unreadCount + 1;
    }

    function onNotificationRemoved(id) {
        var items = bridge.notifications.filter(function (item) {
            return item.id !== id;
        });
        bridge.notifications = items;
    }

    function clearUnread() {
        bridge.unreadCount = 0;
    }

    // ---- sending ----

    /// Send a command. The optional callback receives (ok, data, error).
    function call(name, args, onReply) {
        var id = bridge.nextId;
        bridge.nextId = bridge.nextId + 1;
        if (onReply) {
            bridge.pending[id] = onReply;
        }
        var message = { "t": "cmd", "id": id, "name": name };
        if (args !== undefined && args !== null)
            message.args = args;
        try {
            bridge.socket.write(JSON.stringify(message) + "\n");
            bridge.socket.flush();
        } catch (err) {
            bridge.lastError = "could not send " + name + ": " + err;
        }
        return id;
    }

    function dismissNotification(id) {
        bridge.call("notifications.dismiss", { "id": id });
    }

    function clearNotifications() {
        bridge.call("notifications.clear", {});
    }

    function invokeAction(id, key) {
        bridge.call("notifications.action", { "id": id, "key": key });
    }

    // ---- loading ----

    function reloadTodos() {
        bridge.call("todos.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.todos = payload.items || [];
        });
    }

    function reloadTimer() {
        bridge.call("timer.status", {}, function (ok, payload) {
            if (ok && payload)
                bridge.timer = payload;
        });
    }

    function reloadNotes() {
        bridge.call("notes.list", {}, function (ok, payload) {
            if (ok && payload) {
                bridge.notes = payload.items || [];
                bridge.notesDir = payload.dir || "";
            }
        });
    }

    function reloadClipboard() {
        bridge.call("clipboard.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.clipboard = payload.items || [];
        });
    }

    function reloadTray() {
        bridge.call("tray.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.tray = payload.items || [];
        });
    }

    function reloadWallpapers() {
        bridge.call("wallpaper.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.wallpapers = payload;
        });
    }

    function reloadCalendar() {
        bridge.call("calendar.events", {}, function (ok, payload) {
            if (ok && payload)
                bridge.calendar = payload;
        });
    }

    function reloadSettings() {
        bridge.call("settings.get", {}, function (ok, payload) {
            if (ok && payload)
                bridge.settings = payload;
        });
    }

    function reloadAll() {
        bridge.reloadTodos();
        bridge.reloadTimer();
        bridge.reloadNotes();
        bridge.reloadClipboard();
        bridge.reloadWallpapers();
        bridge.reloadCalendar();
        bridge.reloadSettings();
        bridge.reloadTray();
    }

    // ---- lifecycle ----

    function onConnected() {
        bridge.pendingText = "";
        bridge.consumed = 0;
        bridge.reloadAll();
    }

    function onDisconnected() {
        bridge.notifications = [];
        bridge.activity = null;
        bridge.activities = [];
        bridge.activityChanged();
    }

    /// Reconnect with a short delay. The daemon may be restarting.
    property int retryDelay: 800
    property int retryCount: 0

    function retry() {
        if (bridge.retryCount > 20) {
            bridge.lastError = "the daemon is not answering";
            return;
        }
        bridge.retryCount = bridge.retryCount + 1;
        bridge.retryDelay = Math.min(5000, bridge.retryDelay * 2);
        reconnect.restart();
    }

    // A property rather than a child: QtObject has no default property, so
    // a bare Timer declaration would have nowhere to go.
    property Timer reconnectTimer: Timer {
        id: reconnect
        interval: bridge.retryDelay
        onTriggered: {
            bridge.retryCount = 0;
            bridge.socket.connected = true;
        }
    }

    Component.onCompleted: {
        if (bridge.autoConnect)
            bridge.socket.connected = true;
    }
}
