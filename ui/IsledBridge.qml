import QtQuick
import Quickshell
import Quickshell.Io

// The connection to the isled daemon.
//
// The daemon owns the truth: the todos, the timer, the notes, the clipboard,
// the wallpaper catalog and the live-activity queue all live there. This
// bridge connects to the socket, applies the events that arrive, and sends
// commands back.
//
// It also reconnects. A daemon restart should leave the island alive, not
// leave it showing "offline" until the next login.
QtObject {
    id: bridge

    // ---- where the daemon is ----

    readonly property string explicitSocket: Quickshell.env("ISLED_SOCKET")
    readonly property string runtimeDir: Quickshell.env("XDG_RUNTIME_DIR")
    readonly property string socketPath: explicitSocket
        ? explicitSocket
        : (runtimeDir ? runtimeDir + "/isled/isled.sock" : "/tmp/isled/isled.sock")

    // ---- queue persistence ----
    //
    // The offline queue above would vanish with the UI process. Persist it
    // as JSON (name + args, no callbacks — closures cannot be serialised;
    // callbacks are re-armed only for live calls) so a UI restart re-queues
    // its intents on the next connect.
    readonly property string stateDir: Quickshell.env("XDG_STATE_HOME")
        ? Quickshell.env("XDG_STATE_HOME") + "/isle"
        : Quickshell.env("HOME") + "/.local/state/isle"
    readonly property string queuePath: stateDir + "/queue.json"

    /// The offline queue, persisted as JSON.
    /// Whether the queue has been restored from disk yet. Saves before
    /// restore would overwrite the file (e.g. the startup `ping` queues
    /// before FileView finishes loading) — so saves are gated on this.
    property bool queueRestored: false

    property FileView queueFile: FileView {
        path: bridge.queuePath
        onLoaded: bridge.restoreQueue()
        onLoadFailed: bridge.markQueueRestored()
    }

    // The state directory has to exist before the queue file can be
    // written; the daemon creates it for its own store, but the UI needs
    // it on a fresh install.
    property Process queueMkdir: Process {
        command: ["mkdir", "-p", bridge.stateDir]
        running: true
    }

    property bool connected: false
    /// Whether to reach for the daemon on startup. The preview rig turns it
    /// off when it is only photographing the island.
    property bool autoConnect: true
    property string lastError: ""
    property string lastTopic: ""

    // ---- the state ----

    property var snapshot: null
    property var stats: null
    property var notifications: []
    property int unreadCount: 0

    /// The persistent condition the island is anchored to.
    property var activity: null
    /// Everything the island has seen recently, newest first.
    property var activities: []

    property var todos: []
    property var timer: null
    property var notes: []
    property var notesDir: ""
    property var clipboard: []
    property var wallpapers: null
    property var calendar: null
    property var settings: null
    /// The system tray's items.
    property var tray: []
    /// Who owns the tray bus: "isled", "other" (e.g. Waybar), or
    /// "unknown" (no bus answers). Drives the tray panel's empty state
    /// so an empty tray explains itself instead of looking broken.
    property string trayOwner: "unknown"
    /// The context engine's folded state (idle/busy/away/...).
    property var context: null

    // ---- requests ----

    property int nextId: 1
    property var pending: ({})
    property int pendingBytes: 0

    /// Commands sent while the daemon is unreachable are queued here and
    /// flushed, in order, when the socket comes back. The queue is capped
    /// so an offline afternoon cannot grow it without bound; the oldest
    /// intents are dropped first.
    property var queued: []
    property int queuedCount: 0
    property int queuedCap: 100

    // ---- signals ----

    signal viewRequested(int index)
    signal viewStepped(int delta)
    signal toggleRequested()
    signal focusRequested()
    signal activityTriggered(var activity)
    /// Something wants to say something to the user. The shell puts it in
    /// the snackbar. The action is the label of the one thing they might
    /// want to do about it, or the empty string.
    signal noticeRaised(string message, string action)
    // `activityChanged` is generated by the `activity` property; it is not
    // declared here, or the two would collide.
    signal linkChanged(bool connected)

    // ---- the socket ----

    property Socket socket: Socket {
        id: sock
        path: bridge.socketPath
        connected: false

        onConnectionStateChanged: {
            if (sock.connected) {
                bridge.connected = true;
                bridge.linkChanged(true);
                bridge.onConnected();
            } else {
                bridge.connected = false;
                bridge.linkChanged(false);
                bridge.onDisconnected();
                bridge.retry();
            }
        }

        onError: (err) => {
            bridge.lastError = "socket error " + err;
        }

        parser: StdioCollector {
            id: collector
            waitForEnd: false
            onDataChanged: bridge.feed(collector.text)
        }
    }

    // ---- reading ----

    property string pendingText: ""
    property int consumed: 0

    /// The collector's text is cumulative, so only the part past `consumed` is
    /// new. Everything older has already been parsed.
    function feed(all) {
        if (all.length <= bridge.consumed)
            return;

        bridge.pendingText += all.slice(bridge.consumed);
        bridge.consumed = all.length;

        var lines = bridge.pendingText.split("\n");
        bridge.pendingText = lines.pop();
        for (var i = 0; i < lines.length; i++) {
            bridge.consume(lines[i]);
        }
    }

    function consume(line) {
        var trimmed = line.trim();
        if (trimmed === "")
            return;

        var message;
        try {
            message = JSON.parse(trimmed);
        } catch (err) {
            bridge.lastError = "could not parse " + trimmed;
            return;
        }

        if (message.t === "state") {
            applySnapshot(message.data);
        } else if (message.t === "reply") {
            handleReply(message);
        } else if (message.t === "event") {
            handleEvent(message.topic, message.data);
        }
    }

    function handleReply(message) {
        var callback = bridge.pending[message.id];
        if (callback) {
            delete bridge.pending[message.id];
            callback(message.ok, message.data !== undefined ? message.data : null, message.error);
        }
    }

    function applySnapshot(data) {
        bridge.snapshot = data;
        if (data.notifications !== undefined)
            bridge.notifications = data.notifications;
        if (data.activity !== undefined)
            bridge.activity = data.activity;
        if (data.activities !== undefined)
            bridge.activities = data.activities;
        // `data.features` indicates daemon capabilities (notifications,
        // network manager, etc.). Settings are loaded separately and must
        // not be overwritten by a snapshot — previously this incorrectly
        // set `bridge.settings = null`.
    }

    function handleEvent(topic, data) {
        bridge.lastTopic = topic;

        switch (topic) {
        case "system.stats":
            bridge.stats = data;
            break;
        case "notifications.added":
            bridge.onNotificationAdded(data);
            break;
        case "notifications.removed":
            bridge.onNotificationRemoved(data.id);
            break;
        case "notifications.cleared":
            bridge.notifications = [];
            bridge.unreadCount = 0;
            break;
        case "notifications.action":
            bridge.onNotificationRemoved(data.id);
            break;
        case "view.set":
            bridge.viewRequested(data.index | 0);
            break;
        case "view.step":
            bridge.viewStepped(data.delta | 0);
            break;
        case "island.toggle":
            bridge.toggleRequested();
            break;
        case "island.focus":
            bridge.focusRequested();
            break;
        case "activity.changed":
            bridge.activity = data.ambient !== undefined ? data.ambient : null;
            bridge.activities = data.recent !== undefined ? data.recent : [];
            bridge.activityChanged();
            break;
        case "activity.triggered":
            bridge.activityTriggered(data);
            break;
        case "todos.changed":
            bridge.call("todos.list", {}, function (ok, payload) {
                if (ok && payload)
                    bridge.todos = payload.items || [];
            });
            break;
        case "timer.tick":
        case "timer.changed":
            bridge.timer = data;
            break;
        case "notes.changed":
            bridge.reloadNotes();
            break;
        case "clipboard.changed":
            bridge.reloadClipboard();
            break;
        case "wallpaper.changed":
            bridge.reloadWallpapers();
            break;
        case "context.changed":
            bridge.context = data;
            break;
        case "tray.changed":
            // The payload is the full item list (with resolved icon paths
            // and tooltips), so assign directly instead of refetching.
            // The event payload carries no owner field, so refresh it
            // too — otherwise trayOwner goes stale the first time the
            // bus changes hands.
            bridge.tray = data || [];
            bridge.reloadTray();
            break;
        case "session.lagged":
            bridge.lastError = "missed " + data.missed + " events";
            break;
        default:
            break;
        }
    }

    // ---- notifications ----

    function onNotificationAdded(notification) {
        var items = bridge.notifications.slice();
        var replaced = false;
        for (var i = 0; i < items.length; i++) {
            if (items[i].id === notification.id) {
                items[i] = notification;
                replaced = true;
                break;
            }
        }
        if (!replaced) {
            items.unshift(notification);
        }
        bridge.notifications = items;
        bridge.unreadCount = bridge.unreadCount + 1;
    }

    function onNotificationRemoved(id) {
        var items = bridge.notifications.filter(function (item) {
            return item.id !== id;
        });
        bridge.notifications = items;
    }

    function clearUnread() {
        bridge.unreadCount = 0;
    }

    // ---- sending ----

    /// Send a command. The optional callback receives (ok, data, error).
    /// While the daemon is unreachable the command is queued and returns
    /// its id immediately; the callback still fires when the queue
    /// flushes after a reconnect. Queueing is capped: past queuedCap the
    /// oldest intents are dropped and lastError says so.
    function call(name, args, onReply) {
        var id = bridge.nextId;
        bridge.nextId = bridge.nextId + 1;
        if (onReply) {
            bridge.pending[id] = onReply;
        }
        var message = { "t": "cmd", "id": id, "name": name };
        if (args !== undefined && args !== null)
            message.args = args;
        if (!bridge.connected) {
            bridge.queued.push(message);
            if (bridge.queued.length > bridge.queuedCap) {
                var dropped = bridge.queued.shift();
                bridge.lastError = "queued too many commands — dropped " + dropped.name;
            }
            bridge.queuedCount = bridge.queued.length;
            bridge.saveQueue();
            return id;
        }
        try {
            bridge.socket.write(JSON.stringify(message) + "\n");
            bridge.socket.flush();
        } catch (err) {
            bridge.lastError = "could not send " + name + ": " + err;
        }
        return id;
    }

    /// Persist the offline queue as JSON `{name, args}` entries. Callbacks
    /// are intentionally not serialised — a restored intent executes
    /// server-side but its reply callback is lost, which is the correct
    /// trade: the effect matters, not the confirmation.
    function saveQueue() {
        if (!bridge.queueRestored)
            return;
        var durable = [];
        for (var i = 0; i < bridge.queued.length; i++) {
            var entry = bridge.queued[i];
            durable.push({ "name": entry.name, "args": entry.args === undefined ? {} : entry.args });
        }
        bridge.queueFile.setText(JSON.stringify(durable));
    }

    /// Mark the queue as restored when the file simply does not exist yet
    /// (first run). loadFailed still means "nothing was persisted".
    function markQueueRestored() {
        bridge.queueRestored = true;
    }

    /// Restore queued intents from disk, assigning fresh ids so a UI
    /// restart can never collide with live calls. Flushes immediately if
    /// the daemon is already connected.
    function restoreQueue() {
        bridge.queueRestored = true;
        var restored = [];
        try {
            var text = bridge.queueFile.text();
            if (text) {
                var entries = JSON.parse(text);
                for (var i = 0; i < entries.length && restored.length < bridge.queuedCap; i++) {
                    var entry = entries[i];
                    if (!entry || !entry.name)
                        continue;
                    var id = bridge.nextId;
                    bridge.nextId = bridge.nextId + 1;
                    var message = { "t": "cmd", "id": id, "name": entry.name };
                    if (entry.args !== undefined && entry.args !== null)
                        message.args = entry.args;
                    restored.push(message);
                }
            }
        } catch (err) {
            // A corrupt queue file must not break the shell; start empty.
        }
        if (restored.length > 0) {
            bridge.queued = restored.concat(bridge.queued);
            bridge.queuedCount = bridge.queued.length;
            bridge.saveQueue();
            if (bridge.connected)
                bridge.flushQueue();
        }
    }

    /// Flush the offline queue, oldest first, preserving ids so pending
    /// callbacks still match.
    function flushQueue() {
        var sent = 0;
        var left = [];
        for (var i = 0; i < bridge.queued.length; i++) {
            var message = bridge.queued[i];
            try {
                bridge.socket.write(JSON.stringify(message) + "\n");
                bridge.socket.flush();
                sent++;
            } catch (err) {
                // The socket died mid-flush: keep the rest queued.
                for (var j = i; j < bridge.queued.length; j++)
                    left.push(bridge.queued[j]);
                bridge.lastError = "could not send " + message.name + ": " + err;
                break;
            }
        }
        bridge.queued = left;
        bridge.queuedCount = left.length;
        bridge.saveQueue();
        return sent;
    }

    /// Say something to the user. The shell shows it in the snackbar.
    function announce(message, action) {
        bridge.noticeRaised(message, action === undefined ? "" : action);
    }

    /// Send a command and say what came of it. The message is only said
    /// when the daemon answers; a command queued offline announces that
    /// it is queued, so the user knows the intent was kept.
    function callAndSay(name, args, said, failure) {
        if (!bridge.connected) {
            bridge.announce("Queued — will send when isled is back.");
        }
        bridge.call(name, args, function (ok, payload, error) {
            if (ok) {
                if (said)
                    bridge.announce(said);
            } else {
                bridge.announce(failure ? failure : (error ? error : "That did not work."));
            }
        });
    }

    function dismissNotification(id) {
        bridge.call("notifications.dismiss", { "id": id });
    }

    function clearNotifications() {
        bridge.call("notifications.clear", {});
    }

    function invokeAction(id, key) {
        bridge.call("notifications.action", { "id": id, "key": key });
    }

    // ---- loading ----

    function reloadTodos() {
        bridge.call("todos.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.todos = payload.items || [];
        });
    }

    function reloadTimer() {
        bridge.call("timer.status", {}, function (ok, payload) {
            if (ok && payload)
                bridge.timer = payload;
        });
    }

    function reloadNotes() {
        bridge.call("notes.list", {}, function (ok, payload) {
            if (ok && payload) {
                bridge.notes = payload.items || [];
                bridge.notesDir = payload.dir || "";
            }
        });
    }

    function reloadClipboard() {
        bridge.call("clipboard.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.clipboard = payload.items || [];
        });
    }

    function reloadTray() {
        bridge.call("tray.list", {}, function (ok, payload) {
            if (ok && payload) {
                bridge.tray = payload.items || [];
                bridge.trayOwner = payload.owner || "unknown";
            }
        });
    }

    function reloadWallpapers() {
        bridge.call("wallpaper.list", {}, function (ok, payload) {
            if (ok && payload)
                bridge.wallpapers = payload;
        });
    }

    function reloadCalendar() {
        bridge.call("calendar.events", {}, function (ok, payload) {
            if (ok && payload)
                bridge.calendar = payload;
        });
    }

    function reloadSettings() {
        bridge.call("settings.get", {}, function (ok, payload) {
            if (ok && payload)
                bridge.settings = payload;
        });
    }

    function reloadAll() {
        bridge.reloadTodos();
        bridge.reloadTimer();
        bridge.reloadNotes();
        bridge.reloadClipboard();
        bridge.reloadWallpapers();
        bridge.reloadCalendar();
        bridge.reloadSettings();
        bridge.reloadTray();
    }

    // ---- lifecycle ----

    function onConnected() {
        bridge.pendingText = "";
        bridge.consumed = 0;
        // Flush queued writes BEFORE the reload reads. The bridge sends on
        // one stream and the server dispatches in stream order, so a read
        // issued after the writes observes post-write state — a read
        // issued before would return the pre-write snapshot and the UI
        // would show stale state until the next refresh.
        var sent = bridge.flushQueue();
        bridge.reloadAll();
        if (sent > 0) {
            bridge.announce(sent + " queued item" + (sent === 1 ? "" : "s") + " sent.");
        }
    }

    function onDisconnected() {
        bridge.notifications = [];
        bridge.activity = null;
        bridge.activities = [];
        bridge.activityChanged();
    }

    /// Reconnect with a short delay. The daemon may be restarting.
    property int retryDelay: 800
    property int retryCount: 0

    function retry() {
        if (bridge.retryCount > 20) {
            bridge.lastError = "the daemon is not answering";
            return;
        }
        bridge.retryCount = bridge.retryCount + 1;
        bridge.retryDelay = Math.min(5000, bridge.retryDelay * 2);
        reconnect.restart();
    }

    // A property rather than a child: QtObject has no default property, so
    // a bare Timer declaration would have nowhere to go.
    property Timer reconnectTimer: Timer {
        id: reconnect
        interval: bridge.retryDelay
        onTriggered: {
            bridge.retryCount = 0;
            bridge.socket.connected = true;
        }
    }

    Component.onCompleted: {
        if (bridge.autoConnect)
            bridge.socket.connected = true;
    }
}
